{
  "name": "rostooling-languages",
  "displayName": "Rostooling Languages",
  "description": "Plugin to support Rostooling languages",
  "version": "2.3.0",
  "publisher": "RosTooling",
  "icon": "images/RosTooling_Logo.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipa-esa/RosTooling_Extension.git",
    "directory": "rostooling-languages"
  },
  "bugs": {
    "url": "https://github.com/ipa-esa/RosTooling_Extension/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "bin": {
    "rostooling-mcp": "bin/rostooling-mcp.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "ros",
        "aliases": [
          "ROS",
          "ros"
        ],
        "extensions": [
          ".ros"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ros1",
        "aliases": [
          "ROS1",
          "ros1"
        ],
        "extensions": [
          ".ros1"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ros2",
        "aliases": [
          "ROS2",
          "ros2"
        ],
        "extensions": [
          ".ros2"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rossystem",
        "aliases": [
          "ROS System",
          "rossystem"
        ],
        "extensions": [
          ".rossystem"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ros",
        "scopeName": "source.ros",
        "path": "./syntaxes/ros.tmLanguage.json"
      },
      {
        "language": "ros1",
        "scopeName": "source.ros1",
        "path": "./syntaxes/ros1.tmLanguage.json"
      },
      {
        "language": "ros2",
        "scopeName": "source.ros2",
        "path": "./syntaxes/ros2.tmLanguage.json"
      },
      {
        "language": "rossystem",
        "scopeName": "source.rossystem",
        "path": "./syntaxes/rossystem.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[rossystem]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "punctuation.bracket.yellow.ros",
              "settings": {
                "foreground": "#FFD700",
                "fontStyle": "bold"
              }
            }
          ]
        }
      }
    },
    "assetResources": [
      "server/**/*"
    ],
    "configuration": {
      "title": "ROS Tooling LSP",
      "properties": {
        "rostooling-languages.server.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window"
        },
        "rostooling-languages.java.home": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the JDK 21+ installation folder. Leave empty to use system default Java."
        },
        "rostooling-languages.server.vmargs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-XX:TieredStopAtLevel=1",
            "-Xms256m",
            "-Xmx1024m"
          ],
          "description": "Additional JVM arguments for the RosTooling Language Server process (e.g. tuning flags, memory limits)."
        },
        "rostooling-languages.server.jarPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom RosTooling Language Server fat JAR (e.g., from local Gradle shadowJar builds). If left empty, uses the bundled extension JAR."
        },
        "rostooling-languages.studio.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to Python >= 3.9 interpreter used to launch the CoreSense Studio daemon. Leave empty for automatic discovery."
        },
        "rostooling-languages.studio.serverScriptPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to ipa-rostooling-studio or scripts/studio_server.py. Leave empty for automatic workspace/pip discovery."
        },
        "rostooling-languages.studio.port": {
          "type": "number",
          "default": 8765,
          "description": "Preferred localhost port for the CoreSense Studio HTTP daemon."
        },
        "rostooling-languages.studio.storageRoot": {
          "type": "string",
          "default": "",
          "description": "Directory where CoreSense Studio stores projects, evidence, and session state. Defaults to ~/.rostooling/studio-data."
        },
        "rostooling-languages.agentSkills.promptOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically prompt to install RosTooling AI Agent skills (Claude Code, Antigravity, Cursor) when opening a ROS workspace."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "rostooling.visualStudio",
        "displayName": "RosTooling Visual Studio",
        "selector": [
          {
            "filenamePattern": "*.rossystem"
          },
          {
            "filenamePattern": "*.ros2"
          },
          {
            "filenamePattern": "*.ros1"
          },
          {
            "filenamePattern": "*.ros"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "rostooling.openStudio",
        "title": "Open System Studio (Macro Workbench)",
        "category": "RosTooling",
        "icon": "$(hubot)"
      },
      {
        "command": "rostooling.openStudioStage",
        "title": "Open System Studio Stage in New Window...",
        "category": "RosTooling",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "rostooling.openStudioExternal",
        "title": "Open System Studio in External Browser",
        "category": "RosTooling",
        "icon": "$(globe)"
      },
      {
        "command": "rostooling.promoteToModels",
        "title": "Promote System Architecture to Workspace Models",
        "category": "RosTooling",
        "icon": "$(repo-push)"
      },
      {
        "command": "rostooling.reconcileModels",
        "title": "Reconcile Workspace Models with System Studio",
        "category": "RosTooling",
        "icon": "$(sync)"
      },
      {
        "command": "rostooling.openVisualStudio",
        "title": "Open in Model Studio (Visual Editor)",
        "category": "RosTooling",
        "icon": "$(graph)"
      },
      {
        "command": "rostooling.selectServerJar",
        "title": "Select Language Server JAR...",
        "category": "RosTooling"
      },
      {
        "command": "rostooling.installAgentSkills",
        "title": "Install AI Agent Skills & MCP (Claude Code, Antigravity, Cursor)",
        "category": "RosTooling",
        "icon": "$(sparkle)"
      },
      {
        "command": "rossystem.triggerCodeGeneration",
        "title": "Generate ROS2 Package",
        "category": "ROSSYSTEM"
      },
      {
        "command": "ros2.generateWrappers",
        "title": "Generate ROS 2 Node Wrappers",
        "category": "ROS2"
      },
      {
        "command": "rossdl.buildPackage",
        "title": "Build ROS 2 Package",
        "category": "ROSSDL"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rostooling.openVisualStudio",
          "group": "navigation",
          "when": "resourceLangId == rossystem || resourceLangId == ros2 || resourceLangId == ros || resourceLangId == ros1"
        }
      ],
      "editor/context": [
        {
          "command": "rostooling.openVisualStudio",
          "group": "ROSSYSTEM@50",
          "when": "resourceLangId == rossystem || resourceLangId == ros2 || resourceLangId == ros || resourceLangId == ros1"
        },
        {
          "command": "rossystem.triggerCodeGeneration",
          "group": "ROSSYSTEM@100",
          "when": "resourceLangId == rossystem"
        },
        {
          "command": "ros2.generateWrappers",
          "group": "ROS2@100",
          "when": "resourceLangId == ros2"
        },
        {
          "command": "rossdl.buildPackage",
          "group": "ROSSDL@100",
          "when": "resourceLangId == rossystem || resourceLangId == ros2"
        }
      ],
      "explorer/context": [
        {
          "command": "rostooling.openVisualStudio",
          "group": "navigation",
          "when": "resourceExtname == .rossystem || resourceExtname == .ros2 || resourceExtname == .ros || resourceExtname == .ros1"
        },
        {
          "command": "ros2.generateWrappers",
          "group": "ROS2@100",
          "when": "resourceExtname == .ros2"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:ros",
    "onLanguage:ros1",
    "onLanguage:ros2",
    "onLanguage:rossystem",
    "onCommand:rostooling.openStudio",
    "onCommand:rostooling.openStudioStage",
    "onCommand:rostooling.openStudioExternal",
    "onCommand:rostooling.promoteToModels",
    "onCommand:rostooling.reconcileModels",
    "onCommand:rostooling.openVisualStudio",
    "onCommand:rostooling.selectServerJar",
    "onCommand:rostooling.installAgentSkills",
    "onCommand:ros2.generateWrappers",
    "onCommand:rossystem.triggerCodeGeneration",
    "onCommand:rossdl.buildPackage",
    "onCustomEditor:rostooling.visualStudio"
  ],
  "main": "./out/extension.js",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "postinstall": "npm --prefix src/webview/frontend install",
    "build:webview": "npm --prefix src/webview/frontend run build",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.25.1",
    "eslint": "^9.39.3",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "vscode-languageclient": "^9.0.1",
    "zod": "^4.6.7"
  }
}
