{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ros1",
  "scopeName": "source.ros1",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#package" },
    { "include": "#artifacts" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ros1",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ros1",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.ros1",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "keywords": {
      "begin": "^\\s*((fromGitRepo|artifacts|node|publishers|subscribers|serviceclients|serviceservers|actionclients|actionservers|parameters|type|default|qos|value):)",
      "beginCaptures": {
        "1": { "name": "keyword.control.ros1" }
      },
      "end": "$",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#values" }
      ]
    },
    "package": {
      "patterns": [{
        "comment": "Package: Indentation level 0, before keywords",
        "match": "^([a-zA-Z_][a-zA-Z0-9_]*)(?=:|\\s*$):",
        "name": "entity.name.class.ros1"
      }]
    },
    "artifacts": {
      "patterns": [{
        "comment": "artifacts: Indentation level 2 (4 or 8 spaces)",
        "match": "^( {4}| {8}|\\t{2})([a-zA-Z][a-zA-Z0-9_]*):",
        "captures": {
          "2": { "name": "markup.raw.ros1" }
        }
      }]
    },
    "constants": {
      "patterns": [{
        "comment": "Constants within artifacts at indentation level 4",
        "match": "^( {8}| {16}|\\t{4})([a-zA-Z][a-zA-Z0-9_]*):",
        "captures": {
          "2": { "name": "constant.language.ros1"}
        }
      }]
    },
    "values": {
      "patterns": [{
        "name": "support.variable.ros1",
        "match": "(?i)\\b(True|False|Boolean|Double|Integer|String|Array(?:\\s*\\[[a-zA-Z]+\\])?)(?!\\w)"
      }]
    }
  }
}