{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ros",
  "scopeName": "source.ros",
  "patterns": [
    { "include": "#comments" },
    { "include": "#message_block" },
    { "include": "#keywords" },
    { "include": "#package" },
    { "include": "#interface" }
  ],
  "repository": {
    "message_block": {
      "begin": "^([ \\t]*)(message|request|response|goal|result|feedback):?\\b",
      "beginCaptures": {
        "2": { "name": "keyword.control.ros" }
      },
      "end": "^(?!(?:\\1)[ \\t]+)(?=[ \\t]*[^\\s])",
      "patterns": [
        { "include": "#comments" },
        {
          "match": "([^\\s#]+)(?:\\s+[^\\s#]+)?",
          "captures": {
            "1": { "name": "storage.type.primitive.ros" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ros",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.ros",
        "match": "^\\s*(msgs|srvs|actions):?"
      }]
    },
    "package": {
      "patterns": [{
        "comment": "Package: Indentation level 0, before keywords",
        "match": "^([a-zA-Z_][a-zA-Z0-9_]*)(?=:|\\s*$):",
        "name": "entity.name.class.ros"
      }]
    },
    "interface": {
      "patterns": [{
        "comment": "Interface: Indentation level 2 (4 or 8 spaces)",
        "match": "^( {4}| {8}|\\t{2})([A-Z][a-zA-Z0-9_]*)",
        "captures": {
          "2": { "name": "markup.raw.ros" }
        }
      }]
    }
  }
}