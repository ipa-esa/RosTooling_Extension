{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension (from Repo Root)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/rostooling-languages",
				"${workspaceFolder}/demo/test_ws"
			],
			"outFiles": [
				"${workspaceFolder}/rostooling-languages/out/**/*.js"
			]
		},
		{
			"name": "Run Extension (from rostooling-languages)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}/../demo/test_ws"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			]
		}
	]
}
