test_system:
  fromGitRepo: "https://github.com/jane-doe/project_example.git:branch"
  artifacts:
    image_filter:
      node: image_filter
      publishers:
        filtered_image:
          type: 'sensor_msgs/msg/Image'
          qos:
            profile: sensor_qos
        description:
          type: 'std_msgs/msg/String'
          qos:
            depth: 100
      subscribers:
        marked_image:
          type: 'sensor_msgs/msg/Image'
          qos:
            profile: sensor_qos
            reliability: reliable
        laser_in:
          type: 'sensor_msgs/msg/LaserScan'
          qos:
            profile: sensor_qos
            reliability: reliable
      parameters:
        image_name:
          type: String
          default: "image_raw"
    consumer:
      node: consumer
      publishers:
        marked_image:
          type: 'sensor_msgs/msg/Image'
      subscribers:
        filtered_image:
          type: 'sensor_msgs/msg/Image'
          qos:
            profile: sensor_qos
            reliability: reliable
        description:
          type: 'std_msgs/msg/String'
