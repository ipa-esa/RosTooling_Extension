test_system:
  nodes:
    node1:
      from: "test_system.image_filter"
      interfaces:
        - filtered_image_pub: pub-> "image_filter::filtered_image"
        - description_pub: pub-> "image_filter::description"
        - image_sub: sub-> "image_filter::marked_image"
        - laser_sub: sub-> "image_filter::laser_in"
      parameters:
        - ImageName: "image_filter::image_name"
          value: "image_raw"
    node2:
      from: "test_system.consumer"
      interfaces:
        - filtered_image_sub: sub-> "consumer::filtered_image"
        - description_sub: sub-> "consumer::description"
        - inferenced_image_pub: pub-> "consumer::marked_image"
  connections:
    - ["filtered_image_pub", "filtered_image_sub"]
    - ["description_pub", "description_sub"]
    - ["inferenced_image_pub", "image_sub"]
  processes:
    process1:
      nodes: [ node1, node2 ]
      threads: 2
